# 复制为 .env 后填入真实值（.env 已被 .gitignore 排除，不会入库）
AIBRIDGE_URL=http://localhost:3300/api/bridge/chat
AIBRIDGE_API_KEY=your_aibridge_api_key_here
# 登录会话签名密钥：请用随机 64 位十六进制填充（缺失则每次启动随机生成，重启后登录态失效）
SESSION_SECRET=your_random_64_hex_secret_here

# 站点挂载前缀，缺省即 /novel（生产环境 nginx 把 https://<host>/novel/ 原样转发给本服务）。
# 只接受 /novel 或空串（挂根路径），其它值启动即报错 —— 原因见 src/base.js 文件头。
# BASE_PATH=/novel
